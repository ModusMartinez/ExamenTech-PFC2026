        <di:waypoint x="1100" y="215" />
        <di:waypoint x="1140" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Cad_7" bpmnElement="Flow_Cad_7">
        <di:waypoint x="1165" y="240" />
        <di:waypoint x="1168" y="263" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Cad_8" bpmnElement="Flow_Cad_8">
        <di:waypoint x="1190" y="215" />
        <di:waypoint x="1230" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Cad_9" bpmnElement="Flow_Cad_9">
        <di:waypoint x="1400" y="215" />
        <di:waypoint x="1418" y="215" />
        <di:waypoint x="1418" y="392" />
        <di:waypoint x="1435" y="392" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Cad_10" bpmnElement="Flow_Cad_10">
        <di:waypoint x="1605" y="392" />
        <di:waypoint x="1645" y="392" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Cad_11" bpmnElement="Flow_Cad_11">
        <di:waypoint x="1670" y="417" />
        <di:waypoint x="1670" y="463" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Cad_12" bpmnElement="Flow_Cad_12">
        <di:waypoint x="1695" y="392" />
        <di:waypoint x="1740" y="392" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Cad_13" bpmnElement="Flow_Cad_13">
