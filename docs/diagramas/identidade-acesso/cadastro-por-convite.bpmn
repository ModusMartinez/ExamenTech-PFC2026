<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_Cad_Identidade202611" targetNamespace="https://examentech.example/bpmn/identidade-acesso">
  <bpmn:collaboration id="Collaboration_Cad">
    <bpmn:participant id="Participant_Cad" name="ExamenTech · Cadastro por convite" processRef="Process_Cad"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Cad" name="Cadastro por convite" isExecutable="false">
    <bpmn:documentation>Fluxo de cadastro por convite com RGM obrigatório para novos alunos. O convite determina o perfil e a organização. A rotina preparar_cadastro_com_rgm valida os códigos e o RGM aplicável e, se os dados forem válidos, vincula o RGM ao ticket. O Supabase Auth valida o CAPTCHA no cadastro. A confirmação de e-mail depende da configuração do Auth.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Cad">
      <bpmn:lane id="Lane_Emissor" name="Emissor">
        <bpmn:flowNodeRef>Start_Convite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmitirConvite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EntregarCodigo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Candidato" name="Candidato">
        <bpmn:flowNodeRef>Task_ReceberConvite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LerTermos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Aceite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SemAceite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Formulario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmarEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CadastroPronto</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema" name="Sistema / Supabase">
        <bpmn:flowNodeRef>Task_PrepararCadastro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Convite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ConviteInvalido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CriarConta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Cadastro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_FalhaCadastro</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Convite" name="Início">
      <bpmn:outgoing>Flow_Process_Cad_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_EmitirConvite" name="Emitir convite para o perfil e a organização permitidos">
      <bpmn:incoming>Flow_Process_Cad_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Process_Cad_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EntregarCodigo" name="Entregar os códigos da organização e do convite individual">
      <bpmn:incoming>Flow_Process_Cad_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Process_Cad_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReceberConvite" name="Receber os códigos da organização e do convite">
      <bpmn:incoming>Flow_Process_Cad_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Process_Cad_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_LerTermos" name="Ler os Termos de Uso e a Política de Privacidade">
      <bpmn:incoming>Flow_Process_Cad_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Process_Cad_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Aceite" name="Termos aceitos?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Process_Cad_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Process_Cad_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_Process_Cad_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_SemAceite" name="Cadastro não iniciado">
      <bpmn:incoming>Flow_Process_Cad_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Formulario" name="Preencher dados e códigos RGM obrigatório para aluno Concluir Turnstile">
      <bpmn:incoming>Flow_Process_Cad_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Process_Cad_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_PrepararCadastro" name="Validar organização, convite e RGM do aluno e preparar o ticket">
      <bpmn:incoming>Flow_Process_Cad_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Process_Cad_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Convite" name="Ticket gerado?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Process_Cad_9</bpmn:incoming>
      <bpmn:outgoing>Flow_Process_Cad_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_Process_Cad_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ConviteInvalido" name="Cadastro recusado">
      <bpmn:incoming>Flow_Process_Cad_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_CriarConta" name="Criar conta e perfil ativo, registrar aceite e evento de cadastro">
      <bpmn:incoming>Flow_Process_Cad_11</bpmn:incoming>
      <bpmn:outgoing>Flow_Process_Cad_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Cadastro" name="Conta criada?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Process_Cad_12</bpmn:incoming>
      <bpmn:outgoing>Flow_Process_Cad_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_Process_Cad_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_FalhaCadastro" name="Falha no cadastro">
      <bpmn:incoming>Flow_Process_Cad_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_ConfirmarEmail" name="Confirmar e-mail, quando exigido">
      <bpmn:incoming>Flow_Process_Cad_14</bpmn:incoming>
      <bpmn:outgoing>Flow_Process_Cad_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_CadastroPronto" name="Pronto para entrar">
      <bpmn:incoming>Flow_Process_Cad_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Process_Cad_1" sourceRef="Start_Convite" targetRef="Task_EmitirConvite"/>
    <bpmn:sequenceFlow id="Flow_Process_Cad_2" sourceRef="Task_EmitirConvite" targetRef="Task_EntregarCodigo"/>
    <bpmn:sequenceFlow id="Flow_Process_Cad_3" sourceRef="Task_EntregarCodigo" targetRef="Task_ReceberConvite"/>
    <bpmn:sequenceFlow id="Flow_Process_Cad_4" sourceRef="Task_ReceberConvite" targetRef="Task_LerTermos"/>
    <bpmn:sequenceFlow id="Flow_Process_Cad_5" sourceRef="Task_LerTermos" targetRef="Gateway_Aceite"/>
    <bpmn:sequenceFlow id="Flow_Process_Cad_6" sourceRef="Gateway_Aceite" targetRef="End_SemAceite" name="Não"/>
    <bpmn:sequenceFlow id="Flow_Process_Cad_7" sourceRef="Gateway_Aceite" targetRef="Task_Formulario" name="Sim"/>
    <bpmn:sequenceFlow id="Flow_Process_Cad_8" sourceRef="Task_Formulario" targetRef="Task_PrepararCadastro"/>
    <bpmn:sequenceFlow id="Flow_Process_Cad_9" sourceRef="Task_PrepararCadastro" targetRef="Gateway_Convite"/>
    <bpmn:sequenceFlow id="Flow_Process_Cad_10" sourceRef="Gateway_Convite" targetRef="End_ConviteInvalido" name="Não"/>
    <bpmn:sequenceFlow id="Flow_Process_Cad_11" sourceRef="Gateway_Convite" targetRef="Task_CriarConta" name="Sim"/>
    <bpmn:sequenceFlow id="Flow_Process_Cad_12" sourceRef="Task_CriarConta" targetRef="Gateway_Cadastro"/>
    <bpmn:sequenceFlow id="Flow_Process_Cad_13" sourceRef="Gateway_Cadastro" targetRef="End_FalhaCadastro" name="Não"/>
    <bpmn:sequenceFlow id="Flow_Process_Cad_14" sourceRef="Gateway_Cadastro" targetRef="Task_ConfirmarEmail" name="Sim"/>
    <bpmn:sequenceFlow id="Flow_Process_Cad_15" sourceRef="Task_ConfirmarEmail" targetRef="End_CadastroPronto"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_Cad">
    <bpmndi:BPMNPlane id="Plane_Process_Cad" bpmnElement="Collaboration_Cad">
