        <di:waypoint x="2033" y="215" />
        <di:waypoint x="2050" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Cad_16" bpmnElement="Flow_Cad_16">
        <di:waypoint x="2200" y="215" />
        <di:waypoint x="2240" y="215" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
