# Variáveis públicas disponíveis no navegador
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=
# Ative somente após revisar e aplicar 003, 004 e 005 no mesmo projeto Supabase.
VITE_INVITES_ENABLED=false
# Requer o banco alinhado à sequência canônica até 043.
# Em bases existentes, confira os objetos antes de aplicar migrações.
VITE_MONITORED_EXAMS_ENABLED=true
# Use true para habilitar a consulta de tentativas pelo responsável.
VITE_EXAM_MANAGEMENT_ENABLED=false
# Necessário para iniciar Provas. Ative após configurar bucket privado, avisos e limpeza.
VITE_EXAM_PHOTOS_ENABLED=false

# Variáveis privadas utilizadas somente pelo back-end
# Por padrão, a API usa VITE_SUPABASE_URL e VITE_SUPABASE_PUBLISHABLE_KEY.
# Para uma configuração explícita, descomente e preencha as duas linhas:
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# Escolha uma credencial privada e descomente somente a linha preenchida.
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=
# Deve acompanhar VITE_EXAM_PHOTOS_ENABLED após a preparação descrita em docs.
EXAM_PHOTOS_ENABLED=false
# Segredo aleatório exclusivo do agendador, nunca prefixado com VITE_.
# Opcional: utilizado somente pela alternativa de limpeza na Vercel.
CRON_SECRET=
# Token da limpeza no Supabase. Gerado localmente e cadastrado em Edge Functions.
EXAM_PHOTO_CLEANUP_TOKEN=
