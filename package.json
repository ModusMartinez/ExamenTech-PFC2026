{
  "name": "examentech_vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env.local --watch scripts/api-dev.ts",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration",
    "test:ui": "vitest run --pool=vmThreads --no-file-parallelism",
    "preview": "vite preview",
    "test:unit": "node --test \"tests/*.unit.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/!(*.unit).test.ts\" && npm run test:ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
